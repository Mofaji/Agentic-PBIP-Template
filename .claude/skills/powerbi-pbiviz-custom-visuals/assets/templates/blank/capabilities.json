{
  "dataRoles": [
    { "displayName": "Category", "name": "category", "kind": "Grouping" },
    { "displayName": "Value", "name": "measure", "kind": "Measure" }
  ],
  "dataViewMappings": [
    {
      "conditions": [ { "category": { "max": 1 }, "measure": { "max": 1 } } ],
      "categorical": {
        "categories": {
          "for": { "in": "category" },
          "dataReductionAlgorithm": { "top": { "count": 500 } }
        },
        "values": {
          "select": [ { "bind": { "to": "measure" } } ]
        }
      }
    }
  ],
  "objects": {
    "display": {
      "displayName": "Display",
      "properties": {
        "barColor": { "displayName": "Bar colour", "type": { "fill": { "solid": { "color": true } } } },
        "fontSize": { "displayName": "Text size", "type": { "formatting": { "fontSize": true } } },
        "sortBy": {
          "displayName": "Sort by",
          "type": { "enumeration": [
            { "value": "valueDesc", "displayName": "Value, descending" },
            { "value": "none", "displayName": "Data order" }
          ] }
        },
        "showLabels": { "displayName": "Data labels", "type": { "bool": true } }
      }
    }
  },
  "supportsHighlight": true,
  "supportsMultiVisualSelection": true,
  "privileges": []
}
